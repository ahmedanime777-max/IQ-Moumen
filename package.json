{
  "name": "iq-aptitude-mcp",
  "version": "1.0.0",
  "description": "Generic MCP server that turns user-provided IQ/aptitude PDFs into an interactive reasoning-training knowledge base for ChatGPT.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "ingest": "tsx scripts/ingest.ts",
    "reindex": "tsx scripts/reindex.ts",
    "warmup": "tsx scripts/warmup.ts",
    "make-sample": "tsx scripts/make-sample.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@qdrant/js-client-rest": "1.13.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
